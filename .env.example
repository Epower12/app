# Environment variables for SportPredict
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ---- NextAuth ----
# The canonical URL of your app (no trailing slash)
NEXTAUTH_URL=http://localhost:3000

# Secret for signing JWTs — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NEXTAUTH_SECRET=your-secret-here

# ---- OAuth providers (all optional — each one activates only once both its vars are set) ----
# Redirect/callback URI to register with every provider:
#   https://app.yourfriendleague.com/api/auth/callback/<provider>
# e.g. .../api/auth/callback/google, .../callback/facebook, .../callback/apple, .../callback/discord

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Meta for Developers → your app → Facebook Login → Settings
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Discord Developer Portal → your application → OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Apple Developer → Certificates, IDs & Profiles → Keys (Sign in with Apple)
# APPLE_CLIENT_ID is your Services ID (not the App ID). APPLE_PRIVATE_KEY is the
# .p8 file contents — paste with literal \n for newlines if set as a single env var.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ---- Database ----
# PostgreSQL connection string (local or cloud-hosted)
# Example (Neon): postgresql://user:password@host.neon.tech/dbname?sslmode=require
# Example (local): postgresql://postgres:password@localhost:5432/sport_predictions
DATABASE_URL=postgresql://user:password@host/dbname

# ---- App ----
NODE_ENV=development

# ---- Admin / Owner ----
# The email address of the platform owner (grants access to /owner controls)
NEXT_PUBLIC_OWNER_EMAIL=owner@example.com
